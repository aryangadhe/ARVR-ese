<?xml version="1.0" encoding="utf-8"?>
<robot name="vr_humanoid">

  <!-- Materials -->
  <material name="torso_mat">
    <color rgba="0.15 0.18 0.24 1.0"/>
  </material>
  <material name="limb_mat">
    <color rgba="0.75 0.78 0.82 1.0"/>
  </material>
  <material name="joint_mat">
    <color rgba="0.10 0.65 0.90 1.0"/>
  </material>
  <material name="head_mat">
    <color rgba="0.90 0.92 0.95 1.0"/>
  </material>
  <material name="visor_mat">
    <color rgba="0.0 0.85 1.0 1.0"/>
  </material>
  <material name="foot_mat">
    <color rgba="0.12 0.14 0.18 1.0"/>
  </material>

  <!-- Torso (Base Link) -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.22 0.40"/>
      </geometry>
      <material name="torso_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.22 0.40"/>
      </geometry>
    </collision>
  </link>

  <!-- Head -->
  <link name="head">
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
      <material name="head_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="neck_pitch" type="revolute">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="40" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Left Upper Arm -->
  <link name="left_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.22"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.22"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0.17 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Left Forearm -->
  <link name="left_forearm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_elbow_pitch" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_forearm"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.2" effort="40" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Right Upper Arm -->
  <link name="right_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.22"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.22"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 -0.17 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Right Forearm -->
  <link name="right_forearm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_elbow_pitch" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_forearm"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.2" effort="40" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Left Hip Intermediate (Roll) -->
  <link name="left_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="joint_mat"/>
    </visual>
  </link>

  <joint name="left_hip_roll" type="revolute">
    <parent link="torso"/>
    <child link="left_hip_link"/>
    <origin xyz="0 0.10 -0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="120" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Left Thigh (Pitch) -->
  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.30"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.30"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="150" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Left Shin -->
  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.28"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.28"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_knee_pitch" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.2" effort="150" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Left Foot -->
  <link name="left_foot">
    <inertial>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.11 0.04"/>
      </geometry>
      <material name="foot_mat"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.11 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="100" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Right Hip Intermediate (Roll) -->
  <link name="right_hip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="joint_mat"/>
    </visual>
  </link>

  <joint name="right_hip_roll" type="revolute">
    <parent link="torso"/>
    <child link="right_hip_link"/>
    <origin xyz="0 -0.10 -0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="120" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Right Thigh (Pitch) -->
  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.30"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.30"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="150" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Right Shin -->
  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.28"/>
      </geometry>
      <material name="limb_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.28"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_knee_pitch" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.2" effort="150" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- Right Foot -->
  <link name="right_foot">
    <inertial>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.11 0.04"/>
      </geometry>
      <material name="foot_mat"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.11 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="100" velocity="4.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

</robot>
